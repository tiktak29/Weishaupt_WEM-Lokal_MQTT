{
  "name": "Weishaupt WEM-Lokal MQTT",
  "version": "1.1.1",
  "slug": "wem_mqtt_unified",
  "description": "Local integration for the Weishaupt WEM web interface via MQTT with automatic device detection, persistent validated sessions and session-preserving recovery.",
  "url": "https://github.com/tiktak29/Weishaupt_WEM-Lokal_MQTT",
  "startup": "services",
  "boot": "auto",
  "host_network": false,
  "options": {
    "webinterface_ip_address": null,
    "webinterface_username": null,
    "webinterface_password": null,
    "mqtt_broker": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "mqtt_client",
    "mqtt_password": "",
    "polling_seconds": 10
  },
  "schema": {
    "webinterface_ip_address": "str",
    "webinterface_username": "str",
    "webinterface_password": "password",
    "mqtt_broker": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_username": "str",
    "mqtt_password": "password",
    "polling_seconds": "list(10|15|20|25|30|35|40|45|50|55|60)"
  },
  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ]
}
