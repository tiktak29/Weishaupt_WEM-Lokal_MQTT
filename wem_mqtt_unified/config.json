{
  "name": "Weishaupt WEM-Lokal MQTT",
  "version": "1.0.0",
  "slug": "wem_mqtt_unified",
  "description": "Weishaupt Web-Interface: Wärmepumpe, HK1, HK2, Statistik, 2. WEZ",
  "startup": "services",
  "boot": "auto",
  "host_network": false,

  "options": {
    "webinterface_ip_address": null,
    "webinterface_username": null,
    "webinterface_password": null,
    "webinterface_hex_code": null,

    "mqtt_broker": "core-mosquitto",
    "mqtt_port": 1883,
    "mqtt_username": "mqtt_client",
    "mqtt_password": "",

    "enable_wp": true,
    "enable_hk1": true,
    "enable_hk2": true,
    "enable_stats": true,
    "enable_wez2": true,

    "polling_seconds": 10
  },

  "schema": {
    "webinterface_ip_address": "str",
    "webinterface_username": "str",
    "webinterface_password": "password",
    "webinterface_hex_code": "str",

    "mqtt_broker": "str",
    "mqtt_port": "int(1,65535)",
    "mqtt_username": "str",
    "mqtt_password": "password",

    "enable_wp": "bool",
    "enable_hk1": "bool",
    "enable_hk2": "bool",
    "enable_stats": "bool",
    "enable_wez2": "bool",

    "polling_seconds": "list(10|15|20|25|30|35|40|45|50|55|60)"
  },

  "arch": [
    "aarch64",
    "amd64",
    "armv7"
  ]
}
